# ──────────────────────────────────────────────────────────
# StockScan Enterprise — Frontend Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this to .env and edit for your deployment
# ──────────────────────────────────────────────────────────

# URL of your StockScan NestJS API backend
# If running in the same Docker network: http://stockscan-api:3000
# If running on the host machine: http://host.docker.internal:3000
# If running on another server: http://192.168.1.101:3000
BACKEND_API_URL=http://host.docker.internal:3000

# Public URL where users will access this web portal
# Used for OAuth callbacks, CORS, etc.
NEXTAUTH_URL=http://localhost:3100

# JWT secret — should match your API's JWT secret for token compatibility
NEXTAUTH_SECRET=change-this-to-a-secure-random-string
