# StockScan Web Portal - Environment Configuration
#
# Copy this file to .env and update the values below.
#
# BACKEND_API_URL: URL of your StockScan API
#   - Same server: http://host.docker.internal:3000
#   - Different server: http://192.168.1.x:3000
BACKEND_API_URL=http://host.docker.internal:3000

# NEXTAUTH_URL: Public URL where users access this portal
#   - Replace with your server IP or domain
NEXTAUTH_URL=http://localhost:3100

# NEXTAUTH_SECRET: Random secret for session encryption
#   - Generate one: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-random-secret
